/* 首页样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 统计卡片 */
.stats-section {
  margin-bottom: 30rpx;
}

.stats-card {
  display: flex;
  background: linear-gradient(135deg, #1890ff 0%, #70b8ff 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  color: #fff;
}

.stats-item {
  flex: 1;
  text-align: center;
}

.stats-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}

.stats-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}

/* 快捷入口 */
.quick-actions {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.action-item {
  flex: 1;
  text-align: center;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.action-text {
  display: block;
  font-size: 28rpx;
  color: #333;
}

/* 最近违规 */
.recent-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.more-btn {
  font-size: 26rpx;
  color: #1890ff;
}

.violation-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.violation-item {
  display: flex;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.violation-left {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
}

.violation-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.violation-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6e6e6;
  color: #999;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.violation-right {
  flex: 1;
}

.violation-type {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.violation-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.violation-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-confirmed {
  background: #e6f7ff;
  color: #1890ff;
}

.status-processed {
  background: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background: #fff1f0;
  color: #ff4d4f;
}

.empty-tip, .loading-tip {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
