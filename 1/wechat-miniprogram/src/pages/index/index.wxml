<view class="container">
  <!-- 统计数据卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stats-item">
        <text class="stats-num">{{stats.today}}</text>
        <text class="stats-label">今日新增</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{stats.pending}}</text>
        <text class="stats-label">待处理</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{stats.confirmed}}</text>
        <text class="stats-label">已确认</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{stats.total}}</text>
        <text class="stats-label">总记录</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="goToViolations">
      <image class="action-icon" src="/assets/icons/violation.png" mode="aspectFit" />
      <text class="action-text">违规记录</text>
    </view>
    <view class="action-item" bindtap="goToAppeals">
      <image class="action-icon" src="/assets/icons/appeal.png" mode="aspectFit" />
      <text class="action-text">申诉管理</text>
    </view>
  </view>

  <!-- 最近违规 -->
  <view class="recent-section">
    <view class="section-header">
      <text class="section-title">最近违规</text>
      <view class="more-btn" bindtap="goToViolations">查看全部</view>
    </view>
    
    <view class="violation-list" wx:if="{{!loading}}">
      <view 
        class="violation-item" 
        wx:for="{{recentViolations}}" 
        wx:key="id"
        bindtap="viewViolation"
        data-id="{{item.id}}"
      >
        <view class="violation-left">
          <image 
            class="violation-img" 
            src="{{item.image_path}}" 
            mode="aspectFill"
            wx:if="{{item.image_path}}"
          />
          <view class="violation-placeholder" wx:else>无图</view>
        </view>
        <view class="violation-right">
          <view class="violation-type">{{item.violation_type}}</view>
          <view class="violation-time">{{item.timestamp}}</view>
          <view class="violation-status status-{{item.status}}">
            {{statusMap[item.status]}}
          </view>
        </view>
      </view>
      
      <view class="empty-tip" wx:if="{{recentViolations.length === 0}}">
        暂无违规记录
      </view>
    </view>
    
    <view class="loading-tip" wx:if="{{loading}}">
      加载中...
    </view>
  </view>
</view>
