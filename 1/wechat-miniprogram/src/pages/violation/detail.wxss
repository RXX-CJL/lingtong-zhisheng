/* 违规详情样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.status-card {
  background: linear-gradient(135deg, #1890ff 0%, #70b8ff 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.status-type {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.status-badge {
  display: inline-block;
  padding: 10rpx 30rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.evidence-image {
  width: 100%;
  border-radius: 12rpx;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.detail-label {
  color: #999;
}

.detail-value {
  color: #333;
}

.detail-value.highlight {
  color: #1890ff;
  font-weight: bold;
}

.ai-result {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.btn-appeal {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 44rpx;
}

.btn-appeal-list {
  flex: 1;
  background: #f5f5f5;
  color: #333;
  border-radius: 44rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #999;
}
