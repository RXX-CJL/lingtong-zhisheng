/* 违规列表样式 */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.filter-section {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.filter-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.violation-list {
  padding: 20rpx;
}

.violation-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.violation-type {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-confirmed {
  background: #e6f7ff;
  color: #1890ff;
}

.status-processed {
  background: #f6ffed;
  color: #52c41a;
}

.status-rejected, .status-cancelled {
  background: #f5f5f5;
  color: #999;
}

.card-body {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.label {
  color: #999;
  width: 140rpx;
}

.value {
  color: #333;
}

.confidence {
  color: #1890ff;
  font-weight: bold;
}

.card-footer {
  border-top: 1px solid #f0f0f0;
  padding-top: 20rpx;
}

.evidence-img {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

.empty-state, .load-more, .no-more {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
