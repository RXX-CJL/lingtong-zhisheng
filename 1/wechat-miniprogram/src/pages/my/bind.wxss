/* 车辆绑定页样式（2026-10-03 由 DSH 新增） */
.container { padding: 24rpx; }

.tip-card {
  background: #EFF4FF;
  border-left: 6rpx solid #1D4ED8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.tip-title { font-size: 28rpx; font-weight: 600; color: #1D4ED8; margin-bottom: 8rpx; }
.tip-text { font-size: 24rpx; color: #4B5563; line-height: 1.7; }

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}
.card-title { font-size: 30rpx; font-weight: 600; color: #111827; margin-bottom: 16rpx; }
.empty { padding: 40rpx 0; text-align: center; color: #8A9099; font-size: 26rpx; }

/* 已绑定车辆行 */
.veh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F1F3F6;
}
.veh-row:last-child { border-bottom: none; }
.veh-left { display: flex; flex-direction: column; gap: 6rpx; }
.plate {
  display: inline-block;
  align-self: flex-start;
  padding: 2rpx 14rpx;
  border-radius: 4rpx;
  background: #1D4ED8;
  color: #FFFFFF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.veh-meta { font-size: 22rpx; color: #8A9099; }
.veh-unbind {
  font-size: 26rpx;
  color: #DC2626;
  padding: 8rpx 20rpx;
  border: 2rpx solid #FCA5A5;
  border-radius: 8rpx;
}

/* 建议车牌 */
.suggest-tip { font-size: 22rpx; color: #8A9099; margin-bottom: 14rpx; }
.suggest-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; }
.suggest-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #F5F7FA;
  border: 2rpx solid #E5E7EB;
  border-radius: 10rpx;
}
.suggest-plate { font-size: 26rpx; color: #1F2937; letter-spacing: 1rpx; }
.suggest-count { font-size: 20rpx; color: #8A9099; margin-top: 4rpx; }

/* 手动输入 */
.manual-row { display: flex; align-items: center; gap: 16rpx; }
.manual-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 10rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.manual-btn { width: 160rpx; height: 80rpx; line-height: 80rpx; padding: 0; }
.manual-tip { font-size: 22rpx; color: #8A9099; margin-top: 12rpx; }

/* 下一步 */
.next-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}
.next-text { font-size: 26rpx; color: #4B5563; margin-bottom: 18rpx; }

.btn {
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn-primary { background: #1D4ED8; color: #FFFFFF; }
.btn-ghost { background: #FFFFFF; color: #1D4ED8; border: 2rpx solid #1D4ED8; }
