<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="avatar-section" bindtap="getUserProfile">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="nickname">{{userInfo.nickname}}</view>
      <view class="tips">点击修改头像</view>
    </view>
  </view>

  <!-- 申诉统计 -->
  <view class="stats-section">
    <view class="section-title">申诉统计</view>
    <view class="stats-grid">
      <view class="stat-item pending">
        <text class="stat-num">{{appealStats.pending}}</text>
        <text class="stat-label">待处理</text>
      </view>
      <view class="stat-item reviewing">
        <text class="stat-num">{{appealStats.reviewing}}</text>
        <text class="stat-label">审核中</text>
      </view>
      <view class="stat-item approved">
        <text class="stat-num">{{appealStats.approved}}</text>
        <text class="stat-label">已通过</text>
      </view>
      <view class="stat-item rejected">
        <text class="stat-num">{{appealStats.rejected}}</text>
        <text class="stat-label">已驳回</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view 
      class="menu-item" 
      wx:for="{{menuItems}}" 
      wx:key="id"
      bindtap="onMenuTap"
      data-path="{{item.path}}"
    >
      <image class="menu-icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="menu-title">{{item.title}}</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version">
    <text>智瞳交管小程序 v1.0.0</text>
  </view>
</view>
