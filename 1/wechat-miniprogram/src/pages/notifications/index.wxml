<!-- 通知中心页（2026-10-03 由 DSH 新增） -->
<view class="container">

  <!-- 顶部操作条 -->
  <view class="bar">
    <view class="bar-left">
      <text class="bar-title">通知</text>
      <text class="bar-unread" wx:if="{{unread > 0}}">{{unread}} 条未读</text>
    </view>
    <view class="bar-right">
      <view class="bar-btn {{onlyUnread ? 'active' : ''}}" bindtap="onToggleUnread">
        {{onlyUnread ? '显示全部' : '只看未读'}}
      </view>
      <view class="bar-btn" bindtap="onReadAll" wx:if="{{unread > 0}}">全部已读</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{list.length === 0 && !loading}}" class="empty-card">
    <view class="empty-icon">🔔</view>
    <view class="empty-title">暂无通知</view>
    <view class="empty-text">绑定车辆后，系统识别到你的车牌有违规时会在这里通知你</view>
    <view class="btn btn-primary empty-btn" bindtap="goBind">去绑定车辆</view>
  </view>

  <view class="noti-item {{item.is_read ? 'read' : 'unread'}}"
        wx:for="{{list}}" wx:key="id"
        bindtap="onTapItem" data-id="{{item.id}}">
    <view class="noti-head">
      <text class="noti-title">{{item.title}}</text>
      <text class="noti-dot" wx:if="{{!item.is_read}}"></text>
    </view>
    <view class="noti-body">{{item.body}}</view>
    <view class="noti-foot">
      <text class="plate" wx:if="{{item.plate_number}}">{{item.plate_number}}</text>
      <text class="noti-time">{{item.timeText}}</text>
      <text class="noti-push" wx:if="{{item.pushed}}">已推送</text>
      <text class="noti-push off" wx:else>站内信</text>
    </view>
  </view>

</view>
