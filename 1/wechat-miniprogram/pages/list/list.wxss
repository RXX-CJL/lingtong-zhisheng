/* pages/list/list.wxss */

/* 筛选区 */
.filter-section {
  display: flex;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-item {
  flex: 1;
  text-align: center;
}

.filter-item:first-child {
  border-right: 1rpx solid #f0f0f0;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
  display: inline-flex;
  align-items: center;
}

.arrow {
  font-size: 20rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 记录卡片 */
.list-container {
  padding-bottom: 20rpx;
}

.record-card {
  padding: 20rpx;
}

.record-content {
  display: flex;
}

.record-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  background: #f5f7fa;
}

.record-image image {
  width: 100%;
  height: 100%;
}

.record-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.record-header {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.record-time {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.record-meta {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

.no-more {
  color: #ccc;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: #1890ff;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
}