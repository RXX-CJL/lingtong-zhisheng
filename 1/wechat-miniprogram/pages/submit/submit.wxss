/* pages/submit/submit.wxss */

/* 图片预览区 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
  margin: 0 10rpx 20rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 12rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  margin: 0 10rpx 20rpx;
  background: #f5f7fa;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.image-tip {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-top: 10rpx;
}

/* 违规类型选择 */
.type-scroll {
  white-space: nowrap;
  width: 100%;
}

.type-list {
  display: inline-flex;
  padding: 10rpx 0;
}

.type-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
  background: #f5f7fa;
  border-radius: 40rpx;
  border: 2rpx solid transparent;
  white-space: nowrap;
}

.type-item.active {
  background: #e6f7ff;
  border-color: #1890ff;
}

.type-name {
  font-size: 26rpx;
  color: #666;
}

.type-item.active .type-name {
  color: #1890ff;
}

/* 文本框区域 */
.word-count {
  font-size: 24rpx;
  color: #999;
  text-align: right;
  margin-top: 10rpx;
}

/* 提交按钮 */
.submit-section {
  padding: 40rpx 0;
}

.btn-primary.disabled {
  background: #ccc;
  color: #fff;
}