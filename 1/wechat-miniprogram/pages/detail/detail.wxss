/* pages/detail/detail.wxss */

/* 图片卡片 */
.image-card {
  padding: 20rpx;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
}

/* 信息卡片 */
.info-card,
.cloud-card,
.review-card {
  padding: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  margin-left: 20rpx;
}

.info-divider {
  height: 1rpx;
  background: #f0f0f0;
}

/* 云端分析卡片 */
.cloud-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.cloud-icon {
  font-size: 36rpx;
}

/* 审核卡片 */
.review-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx;
  color: #999;
}

/* 错误状态 */
.error-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 200rpx;
  color: #999;
}

.retry-btn {
  margin-top: 30rpx;
  padding: 20rpx 60rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
}