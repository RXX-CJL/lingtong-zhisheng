/* pages/index/index.wxss */

/* 顶部标题区 */
.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
  background: linear-gradient(135deg, #1890ff 0%, #70b5ff 100%);
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 30rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 功能入口区 */
.entry-section {
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.entry-row {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.entry-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.bg-blue {
  background: linear-gradient(135deg, #1890ff 0%, #70b5ff 100%);
}

.bg-green {
  background: linear-gradient(135deg, #52c41a 0%, #95d674 100%);
}

.bg-orange {
  background: linear-gradient(135deg, #fa8c16 0%, #ffb566 100%);
}

.icon-text {
  font-size: 44rpx;
  color: #fff;
  font-weight: bold;
}

.entry-label {
  font-size: 26rpx;
  color: #666;
}

/* 统计卡片 */
.stats-card {
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stats-content {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 20rpx 0;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
}

.stats-num.confirmed {
  color: #52c41a;
}

.stats-num.pending {
  color: #faad14;
}

.stats-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

.stats-empty {
  text-align: center;
  color: #999;
  padding: 30rpx 0;
}

.stats-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* 提示卡片 */
.tips-card {
  margin-bottom: 20rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
}

.tips-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding: 6rpx 0;
}