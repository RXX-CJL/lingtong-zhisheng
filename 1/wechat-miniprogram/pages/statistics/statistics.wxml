<!--pages/statistics/statistics.wxml-->
<view class="container">
  <!-- 数字卡片区 -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-num">{{stats.total || 0}}</text>
      <text class="stat-label">总举报数</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.today || 0}}</text>
      <text class="stat-label">今日举报</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.week || 0}}</text>
      <text class="stat-label">本周举报</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.month || 0}}</text>
      <text class="stat-label">本月举报</text>
    </view>
  </view>

  <!-- 审核统计 -->
  <view class="card">
    <view class="section-title">审核统计</view>
    <view class="status-grid">
      <view class="status-item">
        <text class="stat-num pending">{{stats.pending || 0}}</text>
        <text class="stat-label">待审核</text>
      </view>
      <view class="status-item">
        <text class="stat-num confirmed">{{stats.confirmed || 0}}</text>
        <text class="stat-label">已确认</text>
      </view>
      <view class="status-item">
        <text class="stat-num rejected">{{stats.rejected || 0}}</text>
        <text class="stat-label">已驳回</text>
      </view>
    </view>
  </view>

  <!-- 违规类型分布 -->
  <view class="card">
    <view class="section-title">违规类型分布</view>
    <view class="type-list" wx:if="{{typeStats.length > 0}}">
      <view class="type-item" wx:for="{{typeStats}}" wx:key="violation_type">
        <view class="type-info">
          <text class="badge-{{item.violation_type}}">{{item.violation_type_name}}</text>
          <text class="type-count">{{item.count}} 条</text>
        </view>
        <view class="type-bar">
          <view
            class="type-bar-fill bg-{{item.violation_type}}"
            style="width: {{item.percent}}%"
          ></view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>
      <text>暂无数据</text>
    </view>
  </view>

  <!-- 我的排名 -->
  <view class="card rank-card" wx:if="{{myRank}}">
    <view class="rank-title">我的排名</view>
    <view class="rank-content">
      <text class="rank-num">第 {{myRank}} 名</text>
      <text class="rank-tip">举报用户排名</text>
    </view>
  </view>
</view>