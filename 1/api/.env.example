# 智瞳灵声项目 - 环境变量配置示例
# 使用方法: 复制本文件为 .env 并填入真实 Key，.env 已被 .gitignore 排除不会提交

# 阿里云百炼 DashScope (豆包视觉分析)
DASHSCOPE_API_KEY=sk-你的DashScope_API_Key

# DeepSeek (代码智能分析/审核)
DEEPSEEK_API_KEY=sk-你的DeepSeek_API_Key

# Claude (可选, 备用视觉分析)
CLAUDE_API_KEY=sk-你的Claude_API_Key
CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# JWT 签名密钥 (生产环境必填; 不填则使用仅限本地开发的默认值)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZHITONG_JWT_SECRET=请填入一段随机字符串

# 数据库路径 (可选, 默认使用 api/zhitong_violations.db)
# DB_PATH=

# 服务端口 (可选)
# PORT=8001
# HOST=0.0.0.0
